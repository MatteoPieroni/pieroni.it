---
type Props = {
  text: string;
  id?: string;
  name: string;
};
const { text, id, name } = Astro.props as Props;
---

<div class="checkbox-wrapper">
  <input id={id ?? name} type="checkbox" />
  <label for={id ?? name}
    ><span>
      <svg width="12px" height="10px">
        <use xlink:href="#check"></use>
      </svg></span
    ><span>{text}</span></label
  >
  <svg class="inline-svg">
    <symbol id="check" viewBox="0 0 12 10">
      <polyline points="1.5 6 4.5 9 10.5 1"></polyline>
    </symbol>
  </svg>
</div>

<style>
  .checkbox-wrapper {
    --spring-duration: 0.25s;
    position: relative;
  }

  .checkbox-wrapper label {
    width: 100%;
    display: inline-block;
    cursor: pointer;
    padding: 0.5rem 0.5rem;
    border-radius: var(--radius);
    overflow: hidden;
    transition: all var(--spring-duration) var(--spring-easing);
    display: inline-block;
    line-height: 0;

    @media (min-width: 960px) {
      width: auto;
    }
  }

  .checkbox-wrapper label:not(:last-child) {
    margin-right: 0.25rem;
  }
  .checkbox-wrapper label:hover,
  .checkbox-wrapper input:focus + label {
    background: rgb(from var(--color-orange) r g b / 0.2);
  }

  .checkbox-wrapper input:focus + label {
    outline: -webkit-focus-ring-color auto 1px;
  }

  .checkbox-wrapper label span {
    vertical-align: middle;
    transform: translate3d(0, 0, 0);
  }

  .checkbox-wrapper label span:first-child {
    display: inline-block;
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    transform: scale(1);
    border: 1px solid #cccfdb;
    transition: all var(--spring-duration) var(--spring-easing);
    box-shadow: 0 1px 1px rgba(0, 16, 75, 0.05);
  }
  .checkbox-wrapper label span:first-child svg {
    position: absolute;
    top: 3px;
    left: 2px;
    fill: none;
    stroke: var(--text);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 16px;
    stroke-dashoffset: 16px;
    transition: all 0.3s ease;
    transition-delay: 0.1s;
    transform: translate3d(0, 0, 0);
  }
  .checkbox-wrapper label span:last-child {
    padding-left: 8px;
    line-height: 18px;
  }
  .checkbox-wrapper label:hover span:first-child,
  .checkbox-wrapper input:focus + label span:first-child {
    border-color: var(--color-orange);
  }
  .checkbox-wrapper input {
    /* remove the checkbox from flow */
    position: absolute;

    /* hide it visually */
    opacity: 0;

    /* tweak size and position if needed */
    width: 1em;
    height: 1em;

    /* position it within the label, on top of the SVG */
    top: 0.5rem;
    left: 0.5rem;
  }

  .checkbox-wrapper input:checked + label span:first-child {
    background: var(--color-orange);
    border-color: var(--color-orange);
    animation: wave 0.4s ease;
  }

  .checkbox-wrapper input:checked + label span:first-child svg {
    stroke-dashoffset: 0;
    transition-timing-function: var(--spring-easing);
    transition-duration: var(--spring-duration);
  }

  .checkbox-wrapper .inline-svg {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
    user-select: none;
  }

  @-moz-keyframes wave {
    50% {
      transform: scale(0.9);
    }
  }
  @-webkit-keyframes wave {
    50% {
      transform: scale(0.9);
    }
  }
  @-o-keyframes wave {
    50% {
      transform: scale(0.9);
    }
  }
  @keyframes wave {
    50% {
      transform: scale(0.9);
    }
  }
</style>

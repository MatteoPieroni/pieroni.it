---
import Image from "../components/Image.astro";
import pellet from "../assets/images/prestagionale-pellet-home.jpg";
---

<div class="featured">
  <div class="featured__image">
    <Image src={pellet} alt="" />
  </div>
  <div class="featured__content">
    <p class="contrast">
      Se sei interessato alla nostra offerta sul prestagionale del pellet 2026,
      affrettati!
    </p>
    <a href="/pellet-offerta-prestagionale-lucca/" class="button contrast"
      >Pellet prestagionale 2026</a
    >
  </div>
</div>

<style>
  .featured {
    background: var(--color-blue);
    display: flex;
    gap: 1rem;
    flex-direction: column;
    align-items: center;
    justify-content: start;
    padding: 1rem;

    @media (min-width: 960px) {
      flex-direction: row;
      align-items: start;
    }
  }

  .featured__image {
    display: none;

    @media (min-width: 960px) {
      display: block;
      max-width: 170px;
      flex: 1;
    }

    img {
      border-radius: var(--radius);
    }
  }

  .featured__content {
    p {
      margin-block-start: 0;
      margin-block-end: 0.5em;
      font-size: 1.5em;

      @media (min-width: 960px) {
        margin-block-end: 0.5em;
        font-size: 1.5em;
      }
    }

    a {
      display: inline-block;
    }
  }
</style>

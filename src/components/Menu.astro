---
// Pieroni.it-style header with desktop + mobile navigation

type MenuItem = {
  label: string;
  href: string;
  children?: MenuItem[];
  extraClass?: string;
};

const secondaryMenu: MenuItem[] = [
  { label: 'Chi Siamo', href: '/chi-siamo/' },
  { label: 'Professionisti', href: '/professionisti-edilizia/' },
  { label: 'Gli Speciali', href: '/category/gli-speciali/' },
  { label: 'Blog', href: '/category/blog/' },
  { label: 'Outlet', href: 'https://outlet.pieroni.it/' },
];

const primaryMenu: MenuItem[] = [
  { label: 'Edilizia', href: '/materiali-edili/' },
  {
    label: 'Sala Mostra',
    href: '/sala-mostra/',
    children: [
      {
        label: 'Bagno',
        href: '/arredo-bagno/',
        children: [
          { label: 'Cabine e Piatti Doccia', href: '/c/bagno/piatti-doccia/' },
          { label: 'Vasche da Bagno', href: '/c/bagno/vasche-da-bagno/' },
          { label: 'Mobili Bagno e Sanitari', href: '/c/bagno/mobili-bagno/' },
          { label: 'Accessori Bagno', href: '/c/bagno/accessori-bagno/' },
        ],
      },
      {
        label: 'Mattonelle',
        href: '/piastrelle-rivestimenti-bagno/',
        children: [
          { label: 'Pavimenti', href: '/c/piastrelle/pavimenti/' },
          { label: 'Rivestimenti', href: '/c/piastrelle/rivestimenti-bagno/' },
          { label: 'Esterni', href: '/c/piastrelle/piastrelle-per-esterno/' },
        ],
      },
      {
        label: 'Riscaldamento',
        href: '/stufe-caldaie-pellet/',
        children: [
          { label: 'Stufe', href: '/c/riscaldamento/stufe-a-pellet-e-legna/' },
          { label: 'Camini', href: '/c/riscaldamento/camini-inserti/' },
          { label: 'Caldaie', href: '/c/riscaldamento/caldaie-a-pellet/' },
          {
            label: 'Offerte e Prezzi Pellet',
            href: '/c/riscaldamento/pellet-prezzi-offerta/',
            extraClass: 'offertacamini',
          },
        ],
      },
    ],
  },
  {
    label: 'Ferramenta',
    href: '/ferramenta/',
    children: [
      {
        label: 'Scarpe antinfortunistiche',
        href: '/ferramenta/scarpe-antinfortunistiche/',
      },
    ],
  },
  {
    label: 'Dove Siamo',
    href: '/magazzino-edile/',
    children: [
      { label: 'Diecimo', href: '/magazzino-edile/diecimo-borgo-a-mozzano/' },
      { label: 'Lucca', href: '/magazzino-edile/lucca-capannori/' },
    ],
  },
  { label: 'Ristrutturazioni', href: '/ristrutturazione/' },
  { label: 'Offerta pellet', href: '/pellet/' },
];

const mobileMenu: MenuItem[] = [
  {
    label: 'Materiali Edili e Attrezzature per l’Edilizia',
    href: '/materiali-edili/',
  },
  { label: 'Sala Mostra', href: '/sala-mostra/' },
  { label: 'Ferramenta, Utensileria e Abbigliamento', href: '/ferramenta/' },
  { label: 'Ristrutturazioni', href: '/ristrutturazione' },
  { label: 'Outlet', href: 'https://outlet.pieroni.it/' },
  { label: 'Dove Siamo', href: '/magazzino-edile/' },
  {
    label: 'Professionisti Edilizia, Sala Mostra, Riscaldamento',
    href: '/professionisti-edilizia/',
  },
  { label: 'Gli Speciali', href: '/category/gli-speciali/' },
  { label: 'Blog', href: '/category/blog/' },
  {
    label: 'Chiusura camini',
    href: '/chiusura-camini/',
    extraClass: 'offertacamini',
  },
];
---

<header id="masthead" class="site-header" role="banner">
  <a class="skip-link screen-reader-text" href="#site-navigation"
    >Vai alla navigazione</a
  >
  <a class="skip-link screen-reader-text" href="#content">Vai al contenuto</a>

  <div class="secondary-navigation__container">
    <div class="col-full">
      <nav
        class="secondary-navigation show-on-desktop"
        role="navigation"
        aria-label="Navigazione secondaria"
      >
        <ul id="menu-secondario" class="menu">
          {
            secondaryMenu.map((item) => (
              <li class="menu-item">
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="col-full">
    <div class="cont-head">
      <div class="site-branding">
        <a href="/" class="custom-logo-link" rel="home" aria-current="page">
          <img
            width="400"
            height="192"
            src="/logo-pieroni-srl-edilizia-sala-mostra.png"
            class="custom-logo"
            alt="Pieroni srl Logo"
          />
        </a>
      </div>

      <nav
        id="site-navigation"
        class="main-navigation"
        role="navigation"
        aria-label="Navigazione principale"
      >
        <button
          class="menu-toggle"
          aria-controls="site-navigation"
          aria-expanded="false"
        >
          <span>Menu</span>
        </button>

        <div class="primary-navigation">
          <ul id="menu-principale" class="menu">
            {
              (() => {
                const renderMenu = (items: MenuItem[]) =>
                  items.map((item) => (
                    <li class={`menu-item ${item.extraClass || ''}`}>
                      <a href={item.href}>{item.label}</a>
                      {item.children && <ul>{renderMenu(item.children)}</ul>}
                    </li>
                  ));

                return renderMenu(primaryMenu);
              })()
            }
          </ul>
        </div>

        <div class="handheld-navigation" aria-label="Navigazione mobile">
          <ul id="menu-mobile" class="menu">
            {
              mobileMenu.map((item) => (
                <li class={`menu-item ${item.extraClass || ''}`}>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>

          <form role="search" method="get" class="search-form" action="/">
            <label>
              <span class="screen-reader-text">Ricerca per:</span>
              <input
                type="search"
                class="search-field"
                placeholder="Cerca …"
                value=""
                name="s"
              />
            </label>
            <input type="submit" class="search-submit" value="Cerca" />
          </form>
        </div>
      </nav>

      <div class="show-on-desktop">
        <form role="search" method="get" class="search-form" action="/">
          <label>
            <span class="screen-reader-text">Ricerca per:</span>
            <input
              type="search"
              class="search-field"
              placeholder="Cerca …"
              value=""
              name="s"
            />
          </label>
          <input type="submit" class="search-submit" value="Cerca" />
        </form>
      </div>
    </div>
  </div>

  <div class="menu__featured--container">
    <nav class="menu__featured" aria-label="Scorciatoie">
      <a href="/sala-mostra/">Sala Mostra</a>
      <a href="/materiali-edili/">Edilizia</a>
      <a href="/professionisti-edilizia/">Professionisti</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    --menu-padding: 1rem;

    padding-inline: var(--menu-padding);
    padding-block-start: var(--menu-padding);

    @media (min-width: 960px) {
      --menu-padding: 0;
    }
  }

  .secondary-navigation__container {
    background: darkorange;
  }

  .secondary-navigation {
    width: 100%;
    font-size: 0.9rem;
    padding-inline: 1rem;
  }

  .secondary-navigation ul.menu {
    display: flex;
    justify-content: flex-end;
    padding: 0.75rem 0;
  }

  .secondary-navigation li {
    padding-inline: 0.75rem;
    font-size: 0.75rem;
    text-transform: lowercase;

    &:not(:last-child) {
      border-inline-end: 1px solid var(--color-link);
    }
  }

  .secondary-navigation ul.menu a {
    text-decoration: none;
  }

  .secondary-navigation ul.menu a:hover {
    text-decoration: underline;
  }

  .cont-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 1rem;
  }

  .site-branding {
    display: flex;
    width: 30%;

    @media (min-width: 960px) {
      width: auto;
    }
  }

  .site-header .custom-logo-link img {
    max-width: 88px;
    border-radius: 0;
    height: auto;

    @media (min-width: 768px) {
      max-height: 70px;
      max-width: none;
      width: auto;
    }
  }

  .main-navigation {
    flex-grow: 1;
    text-align: center;
  }

  .primary-navigation {
    display: none;
    @media (min-width: 960px) {
      display: block;
    }
  }

  .main-navigation ul {
    list-style: none;
  }

  .main-navigation ul.menu {
    @media (min-width: 960px) {
      display: flex;
      flex-wrap: wrap;
    }
  }

  .main-navigation .menu li {
    &:not(:last-child) {
      @media (min-width: 960px) {
        border-inline-end: 1px solid #d6d6d6;
      }
    }
  }

  .main-navigation ul.menu a {
    display: inline-block;
    padding-inline: 1rem;
    padding-block: 0.25rem;
    width: 100%;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.95rem;

    &:focus,
    &:hover {
      text-decoration: underline;
    }
  }

  .menu li {
    position: relative;
  }

  .menu ul li {
    &:has(> a:hover) {
      background-color: rgba(0, 0, 0, 0.025);
    }
  }

  .menu ul li a {
    padding: 0.5rem 1rem;
    font-weight: 400;
    font-size: 0.875rem;
    padding-block: 0.75rem;
  }

  .menu ul {
    position: absolute;
    white-space: nowrap;
    background: var(--color-bg-darker);
    box-shadow: 0 20px 66px 0 rgba(34, 48, 73, 0.2);
    z-index: 1;
    left: -99999em;
    padding: 0;
  }

  .menu > li {
    &:hover > ul,
    &:focus-within > ul {
      left: auto;
      min-width: 100%;

      li:hover {
        background-color: rgba(0, 0, 0, 0.025);
      }
    }
  }
  .menu > li li {
    &:hover > ul,
    &:focus-within > ul {
      left: 100%;
      margin-left: 1px;
      top: -1px;
    }
  }

  .offertacamini a {
    color: darkorange;
  }

  .search-form {
    display: flex;
    gap: 0.25rem;
  }

  .menu-toggle {
    position: relative;
    background: var(--color-bg);
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    margin-right: 0;
    margin-left: auto;
    display: block;

    border: 2px solid #333;
    box-shadow: none;
    border-radius: 2px;
    padding: 0.5rem 0.875rem 0.5rem 2.5rem;
    font-size: 0.875em;
    max-width: 120px;

    @media (min-width: 960px) {
      display: none;
    }
  }

  .menu-toggle span {
    display: inline-block;
  }

  .menu-toggle::before,
  .menu-toggle::after,
  .menu-toggle span:before {
    content: '';
    display: block;
    height: 2px;
    width: 14px;
    position: absolute;
    top: 50%;
    left: 1em;
    margin-top: -1px;
    -webkit-transition: all, ease, 0.2s;
    transition: all, ease, 0.2s;
    border-radius: 3px;
    background-color: #333;
  }

  .menu-toggle::before {
    transform: translateY(-4px);
  }

  .menu-toggle::after {
    transform: translateY(4px);
  }

  .menu-toggle.is-open::before {
    transform: rotate(45deg);
  }

  .menu-toggle.is-open::after {
    transform: rotate(-45deg);
  }

  .menu-toggle.is-open span::before {
    opacity: 0;
  }

  .handheld-navigation {
    display: none;
    margin-top: 0.75rem;

    @media (min-width: 960px) {
      display: none;
    }
  }

  .handheld-navigation.is-open {
    display: block;
  }

  .handheld-navigation .menu {
    display: grid;
    gap: 0.25rem;
  }

  .handheld-navigation a {
    display: block;
    text-align: right;
    padding: 0.45rem 0.5rem;
    text-decoration: none;
  }

  .handheld-navigation a:hover {
    background: var(--color-bg-darker);
  }

  .menu__featured--container {
    margin-inline: calc(var(--menu-padding) * -1);
  }

  .menu__featured {
    display: flex;

    @media (min-width: 960px) {
      display: none;
    }
  }

  .menu__featured a {
    flex-grow: 1;
    border: 1px solid #d6d6d6;
    padding: 0.35rem 0.5rem;
    text-align: center;
    font-size: 0.8rem;
    text-transform: uppercase;
    text-decoration: none;

    &:not(:last-child) {
      border-inline-end: none;
    }
  }

  .menu__featured a:hover {
    text-decoration: underline;
  }
</style>

<script>
  if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      const header = document.getElementById('masthead');
      if (!header) return;

      const toggle = header.querySelector('.menu-toggle');
      const handheldNav = header.querySelector('.handheld-navigation');
      if (!toggle || !handheldNav) return;

      const openClass = 'is-open';

      const setOpen = (open: boolean) => {
        handheldNav.classList.toggle(openClass, open);
        toggle.classList.toggle(openClass, open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      };

      toggle.addEventListener('click', () => {
        const isOpen = handheldNav.classList.contains(openClass);
        setOpen(!isOpen);
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 960) {
          setOpen(false);
        }
      });
    });
  }
</script>

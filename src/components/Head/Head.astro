---
import { SEO } from 'astro-seo';
import Favicons from './Favicons.astro';
import Schema from './Schema.astro';
import type { PropsWithSEO } from '../../layouts/types';

type Props = PropsWithSEO & {
  breadcrumbs?: Array<{
    label: string;
    href: string;
  }>;
  isHome?: true;
  fontToPreload: string;
};

const { description, title, breadcrumbs, fontToPreload, isHome } = Astro.props;
---

<head>
  <meta charset="utf-8" />
  <link
    rel="preload"
    as="font"
    type="font/woff2"
    href={fontToPreload}
    crossorigin="anonymous"
  />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <link rel="profile" href="https://gmpg.org/xfn/11" />
  <SEO
    title={title}
    titleTemplate={isHome ? undefined : `%s | Pieroni srl`}
    description={description}
  />
  <Schema breadcrumbs={breadcrumbs} description={description} />
  <Favicons />
</head>

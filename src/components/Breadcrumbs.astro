---
import { Icon } from 'astro-icon/components';

interface Props {
  items?: Array<{
    label: string;
    href: string;
  }>;
}

const { items = [] } = Astro.props;

// Don't render if no items provided
if (items.length === 0) {
  return null;
}
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/"><Icon name="tabler:home" />Home</a>
  {
    items.map((item, index) => (
      <>
        <Icon name="tabler:chevron-right" class="breadcrumb-separator" />
        {index === items.length - 1 ? (
          <span class="breadcrumb-current">{item.label}</span>
        ) : (
          <a href={item.href}>{item.label}</a>
        )}
      </>
    ))
  }
</nav>

<style>
  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    font-size: 0.875em;
    padding: 1rem 0;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    gap: 0.15em;
  }

  .breadcrumb-separator {
    display: inline-block;
  }
</style>

---
import { Image as AstroImage } from 'astro:assets';

type Props = {
  alt: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  priority?: boolean;
} & (
  | {
      src: ImageMetadata;
      remote?: never;
    }
  | {
      src: string;
      remote: true;
    }
);

const { loading = 'lazy', src, remote, ...rest } = Astro.props;

const remoteProps = remote
  ? {
      src,
      inferSize: true as const,
    }
  : {
      src,
    };
---

<AstroImage {...remoteProps} loading={loading} {...rest} />

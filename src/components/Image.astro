---
import { Image as AstroImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  layout?: 'constrained' | 'fixed' | 'fullWidth';
  placeholder?: 'blurhash' | 'dominantColor' | 'empty';
  loading?: 'lazy' | 'eager';
  width?: number;
  height?: number;
  aspectRatio?: number;
  class?: string;
  unstyled?: boolean;
}

const {
  layout = 'constrained',
  placeholder = 'blurhash',
  ...rest
} = Astro.props;
---

<AstroImage {...rest} />

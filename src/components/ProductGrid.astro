---
interface Product {
  name: string;
  image?: string;
  category: string;
  link: string;
}

const { products } = Astro.props as { products: Product[] };
---

<section class="section">
  <div class="container">
    <header class="section-header">
      <p class="section-kicker">Nuovi prodotti</p>
      <h2 class="section-title">Una selezione dal nostro catalogo.</h2>
      <p class="section-description">
        Collezioni di pavimenti, rivestimenti, arredo bagno e riscaldamento selezionate dai
        nostri showroom.
      </p>
    </header>

    <div class="products-grid">
      {products.map((product) => (
        <article class="product-card">
          <a href={product.link}>
            <div class="product-thumb">
              <span>{product.name}</span>
            </div>
            <div class="product-name">{product.name}</div>
            <div class="product-meta">{product.category}</div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>


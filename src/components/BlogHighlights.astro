---
interface BlogPost {
  title: string;
  link: string;
  tag?: string;
}

const { posts } = Astro.props as { posts: BlogPost[] };
---

<section class="section">
  <div class="container blog-layout">
    <div>
      <header class="section-header">
        <p class="section-kicker">Dal nostro blog</p>
        <h2 class="section-title">Idee, consigli e novità dal mondo Pieroni.</h2>
        <p class="section-description">
          Approfondimenti su bonus, soluzioni tecniche, ispirazioni per bagno, pavimenti,
          rivestimenti e riscaldamento.
        </p>
      </header>

      {posts[0] && (
        <article class="blog-main-card">
          <p class="tag">In evidenza</p>
          <h3>
            <a href={posts[0].link}>{posts[0].title}</a>
          </h3>
          <p>
            Scopri come progettare o rinnovare la tua casa con soluzioni concrete e le novità
            dal nostro catalogo.
          </p>
          <div class="blog-meta">
            <span>Articoli aggiornati periodicamente</span>
            <a href="/blog" class="pill-link">
              Vai al blog
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      )}
    </div>

    <div>
      <ul class="blog-list">
        {posts.slice(1).map((post) => (
          <li>
            <a href={post.link}>
              <span>{post.title}</span>
              {post.tag && <small>{post.tag}</small>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>


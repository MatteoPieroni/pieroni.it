---
import LocationLayout from '../../layouts/LocationLayout.astro';
import heroImageAsset from '../../assets/images/pieroni-srl-map-magazzini.jpg';

const title = 'Diecimo';
const heroImage = heroImageAsset;
const locationName = 'Magazzino di Diecimo';
const address = {
  label: 'Loc. Pastino 67, Diecimo, Borgo a Mozzano (LU)',
  href: 'https://maps.google.com/maps?ll=43.955955,10.502336&z=14&t=m&hl=it-IT&gl=IT&mapclient=embed&daddr=Pieroni%20srl%20Localit%C3%A0%20Pastino%2C%2067%2055023%20Diecimo%20LU@43.955955,10.502336',
};
const phone = '0583-838375';
const email = 'info@pieroni.it';
const hours = [
  { day: 'Da Lunedì a Venerdì', times: '07:30 - 12:00' },
  { day: '', times: '13:30 - 18:00' },
  { day: 'Sabato', times: '07:30 - 12:00' },
];
const breadcrumbs = [
  { label: 'Dove Siamo', href: '/magazzino-edile/' },
  { label: 'Diecimo', href: '/magazzino-edile/diecimo-borgo-a-mozzano/' },
];
---

<LocationLayout
  title={title}
  heroImage={heroImage}
  locationName={locationName}
  address={address}
  phone={phone}
  email={email}
  hours={hours}
  breadcrumbs={breadcrumbs}
  seoTitle="Diecimo"
  description="Magazzino edile Pieroni srl a Diecimo (Borgo a Mozzano): materiali da costruzione, ferramenta e attrezzature con ampia disponibilità e assistenza professionale"
/>

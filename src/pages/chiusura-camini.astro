---
import Image from '../components/Image.astro';
import LandingLayout from '../layouts/LandingLayout.astro';
import Logo from '../assets/landings/chiusura-camini/PIERONI-LOGO.png';
import Stars from '../assets/landings/chiusura-camini/PIERONI-5stelle.png';
import EdilkaminLogo from '../assets/landings/chiusura-camini/PIERONI-edilkamin.png';
import Fireplace from '../assets/landings/chiusura-camini/PIERONI-caminetti.jpg';
import Header from '../assets/landings/chiusura-camini/PIERONI-header.jpg';
import Scripts from '../components/Footer/Scripts.astro';
---

<LandingLayout
  title="Contributi per camini a 5 stelle"
  description="Contributo per la chiusura del tuo vecchio camino"
>
  <div class="pre-header">
    <a href="/" class="logo-link">
      <Image src={Logo} alt="" class="logopieroni" />
    </a>

    <p>Un'offerta super!</p>
  </div>
  <div class="header" style={`background-image:url('${Header.src}')`}>
    <Image src={Stars} alt="Camini a 5 stelle" class="stelle" />
    <Image src={EdilkaminLogo} alt="Logo Edilkamin" class="edilkaminlogo" />
  </div>
  <div class="main">
    <h1>Fino a 4000€ di contributo!</h1>
    <p>
      Se chiudi il tuo vecchio camino con un inserto a legna o a pellet <span
        >Certificato 5 stelle</span
      >
      <p class="upp">
        vieni ad informarti subito<p>I contributi stanno per scadere</p>
        <Image src={Fireplace} class="caminetti" alt="Camini pieroni" />
        <a class="button" href="tel:+390583838375">CHIAMA ORA</a>
      </p>
    </p>
  </div>
  <footer>
    <p style="font-size:1rem;margin-top:3rem;margin-bottom:3rem;">
      Loc. Pastino 67, Diecimo (LU) – Via della Canovetta 341, Lucca Tel.
      0583-838375 – Mail. <a href="mailto:info@pieroni.it">info@pieroni.it</a> - P.I.
      01798100465
    </p>
  </footer>

  <Scripts />
</LandingLayout>

<style>
  h1,
  h2,
  h3,
  h4,
  p {
    color: #ee223b;
  }

  a.button {
    padding: 30px;
    color: white;
    font-weight: 600;
    text-decoration: none;
    font-size: 2rem;
    background-color: #ee223b;
    margin-top: 3rem;
  }

  a:hover {
    transition: 0.3s;
    opacity: 0.8;
  }

  .header {
    min-height: 60dvh;
    background-size: cover;
    background-position: bottom;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  h1 {
    font-size: 6rem;
    font-weight: 900;
    text-align: center;
    margin: 0;
    margin-top: 2rem;
  }

  p {
    text-align: center;
    padding: 0;
    font-size: 3rem;
    font-weight: 700;
    margin: 0;
  }

  p span {
    background: var(--color-orange);
    color: white;
    padding-right: 10px;
    padding-left: 10px;
    font-weight: 700;
    display: inline-table;
  }

  .upp {
    text-transform: uppercase;
  }

  .edilkaminlogo {
    width: 400px;
  }

  .stelle {
    width: 900px;
  }

  .logo-link {
    background: none;
    padding: 0;
    margin: 0;
  }

  .logopieroni {
    width: 175px;
    margin-top: 2rem;
    margin-bottom: 2rem;
    margin-left: 2rem;
  }

  .pre-header p {
    margin-top: 2rem;
    margin-bottom: 2rem;
    margin-right: 2rem;
    background: var(--color-orange);
    color: white;
    padding-right: 10px;
    padding-left: 10px;
    font-weight: 700;
  }

  .caminetti {
    margin-top: 3rem;
  }

  .pre-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    box-shadow: 3px 3px 3px 3px gray;
  }

  @media only screen and (max-width: 600px) {
    .header {
      min-height: 50dvh;
      background-size: cover;
      background-position: bottom;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    h1 {
      font-size: 3rem;
      font-weight: 900;
      text-align: center;
      margin: 0;
      margin-top: 2rem;
      padding: 12px;
    }

    p {
      text-align: center;
      padding: 0;
      font-size: 1.8rem;
      font-weight: 700;
      margin: 0;
      padding: 8px;
    }

    p span {
      background: var(--color-orange);
      color: white;
      padding-right: 10px;
      padding-left: 10px;
      font-weight: 700;
      margin-top: 5px;
      margin-bottom: 5px;
      display: inline-table;
    }

    .edilkaminlogo {
      width: 230px;
    }

    .pre-header {
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      box-shadow: 3px 3px 3px 3px gray;
    }

    .logopieroni {
      width: 155px;
      margin-top: 1rem;
      margin-bottom: 0rem;
      margin-left: 0rem;
    }

    .pre-header p {
      margin-top: 1rem;
      margin-bottom: 1rem;
      margin-right: 0rem;
      background: var(--color-orange);
      color: white;
      padding-right: 10px;
      padding-left: 10px;
      font-weight: 700;
    }
  }
</style>

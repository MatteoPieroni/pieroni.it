---
import CategoryLayout from '../layouts/CategoryLayout.astro';
import heroImageAsset from '../assets/images/pieroni-srl-map-magazzini.jpg';
import diecimoImage from '../assets/images/pieroni-magazzino-sala-mostra-diecimo-borgo-mozzano-lucca.jpg';
import luccaImage from '../assets/images/pieroni-magazzino-lucca-edile.jpg';

const title = 'Dove Siamo';
const breadcrumbs = [{ label: 'Dove Siamo', href: '/magazzino-edile/' }];
const heroImage = heroImageAsset;
const description = `
  <p>Avere 2 magazzini ci permette di raggiungerti nel posto più vicino possibile.</p>
`;

const gridItems = [
  {
    image: diecimoImage,
    imageAlt: 'Pieroni Magazzino Diecimo',
    title: 'Magazzino di Diecimo',
    description: `
      <p>Magazzino Edile, Sala Mostra di Diecimo</p>
    `,
    linkHref: 'diecimo-borgo-a-mozzano/',
    linkText: 'Scopri il magazzino di Diecimo',
  },
  {
    image: luccaImage,
    imageAlt: 'Pieroni Magazzino Lucca',
    title: 'Magazzino di Lucca',
    description: `
      <p>Magazzino Edile di Lucca</p>
    `,
    linkHref: 'lucca-capannori/',
    linkText: 'Scopri il magazzino di Lucca',
  },
];
---

<CategoryLayout
  title={title}
  heroImage={heroImage}
  seoTitle="Dove Siamo"
  description="Indicazioni per Raggiungere il Magazzino Edile Pieroni Srl nelle due Sedi di Diecimo e Lucca"
  gridItems={gridItems}
  breadcrumbs={breadcrumbs}
  withoutLocations={true}
>
  <Fragment slot="description" set:html={description} />
</CategoryLayout>

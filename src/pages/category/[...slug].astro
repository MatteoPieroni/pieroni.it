---
import type { CategoryPageProps as BaseCategoryPageProps } from "../../layouts/types";
import { getAllCategories } from "../../data/blog";
import BlogCategoryLayout from "../../layouts/BlogCategoryLayout.astro";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";

export async function getStaticPaths() {
  const { categories, articlesPages, allCategories } = await getAllCategories();

  const categoryPages: {
    params: { slug: string };
    props: CategoryPageProps;
  }[] = categories.map(({ slug, ...category }) => ({
    params: {
      slug,
    },
    props: {
      ...category,
      allCategories,
    },
  }));

  const usableArticlePages: {
    params: { slug: string };
    props: ArticlePageProps;
  }[] = articlesPages.map(({ slug, ...article }) => ({
    params: {
      slug,
    },
    props: {
      ...article,
    },
  }));

  return [...categoryPages, ...usableArticlePages];
}

type Image = {
  alt: string;
  url: string;
};

type CategoryPageProps = BaseCategoryPageProps & {
  articles: {
    fullSlug: string;
    featuredImage: Image;
    title: string;
    excerpt: string;
    createdAt: string;
    contentUpdatedAt: string;
  }[];
  allCategories: {
    href: string;
    title: string;
  }[];
};

type ArticlePageProps = {
  excerpt: string;
  content: Record<string, unknown>;
  contentUpdatedAt: string;
  createdAt: string;
  featuredImage: Image;
  categories: {
    name: string;
    url: string;
  }[];
};

type Props = {
  title: string;
  fullSlug: string;
  breadcrumbs: { label: string; url: string }[];
} & (CategoryPageProps | ArticlePageProps);

const { title, fullSlug: passedFullSlug, breadcrumbs, ...props } = Astro.props;
const { slug } = Astro.params;

const fullSlug = `/category/${passedFullSlug}/`;

const checkIsCategoryPage = (
  props: CategoryPageProps | ArticlePageProps,
): props is CategoryPageProps => {
  if ("articles" in props) {
    return true;
  }

  return false;
};

// Determine if this is a category page or product page
const isCategoryPage = checkIsCategoryPage(props);

const formattedBreadcrumbs = [
  { label: "Blog", href: "/category/" },
  ...breadcrumbs.map(({ url, label }) => ({
    label,
    href: `/category${url}/`,
  })),
  ...(!isCategoryPage
    ? [
        {
          label: title,
          href: fullSlug,
        },
      ]
    : []),
];
---

{
  isCategoryPage ? (
    <BlogCategoryLayout
      title={title}
      breadcrumbs={formattedBreadcrumbs}
      fullSlug={fullSlug}
      subCategories={props.subCategories}
      pagination={props.pagination}
      count={props.count}
      articles={props.articles}
      allCategories={props.allCategories}
    />
  ) : (
    <BlogPostLayout
      currentUrl={slug}
      title={title}
      breadcrumbs={formattedBreadcrumbs}
      fullSlug={fullSlug}
      featuredImage={props.featuredImage}
      categories={props.categories}
      content={props.content}
      createdAt={props.createdAt}
      contentUpdatedAt={props.contentUpdatedAt}
      excerpt={props.excerpt}
      description={props.excerpt}
    />
  )
}

---
import {
  getAllBlogCategories,
  getCategoriesFromId,
  getCategoriesFromSlug,
} from '../../data/blog';
import BlogCategoryLayout from '../../layouts/BlogCategoryLayout.astro';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { remoteToLocalUrl, swapImageUrlDomain } from '../../utils/remoteLinks';
import blogCategoriesData from '../../data/blog/categories.json';
import { getFlatCategories } from '../../data/products';

const WORDPRESS_URL = 'https://www.pieroni.it/wp-json/wp/v2';

export async function getStaticPaths() {
  const { categories, postsPages } = await getAllBlogCategories();

  const categoryPages = categories.map(({ slug, ...category }) => ({
    params: {
      slug,
    },
    props: {
      ...category,
    },
  }));

  const usableProductPages = postsPages.map((page) => ({
    params: {
      slug: page.slug,
    },
    props: {
      post: page.product,
    },
  }));

  return [...categoryPages, ...usableProductPages];
}

interface Props {
  post?: any;
  products?: any[];
  subCategories?: any[];
  title?: string;
  count?: {
    total: number;
    start: number;
    end: number;
  };
  pagination?: {
    current: PaginationPage;
    previous: PaginationPage;
    next: PaginationPage;
    first: PaginationPage;
    last: PaginationPage;
  };
}

type PaginationPage = {
  number: number;
  href: string;
};

const {
  post,
  products,
  subCategories,
  title: catTitle,
  pagination,
  count,
} = Astro.props;
const { slug } = Astro.params;

// Determine if this is a category page or product page
const isCategoryPage = products && catTitle && count;
const isPostPage = post;

// Initialize variables for both page types
let formattedPosts: any[] = [];
let formattedSubcategories: any[] = [];
let title = '';
let date = '';
let content = '';
let excerpt = '';
let categories: any[] = [];
let featuredImage = undefined;
let allCategories: { href: string; title: string }[] = [];

// remove the numbered pages
const cleanSlug = slug.replace(/\/page\/.*/, '');
const categoriesForBreadcrumbs = getCategoriesFromSlug(
  cleanSlug.split('/'),
  blogCategoriesData,
);

const breadcrumbs = [
  { label: 'Blog', href: '/category/' },
  ...categoriesForBreadcrumbs.reduce<{ label: string; href: string }[]>(
    (acc, currentCategory) => {
      const lastElementInAcc = acc.at(-1);

      return [
        ...acc,
        {
          label: currentCategory.name,
          href: lastElementInAcc
            ? `${lastElementInAcc.href}/${currentCategory.slug}`
            : `/category/${currentCategory.slug}`,
        },
      ];
    },
    [],
  ),
];

if (isCategoryPage) {
  formattedPosts = (products || []).map((p: any) => ({
    title: p.title.rendered,
    excerpt: p.excerpt.rendered,
    date: p.date,
    // featuredImage?: {
    //   src: string;
    //   alt: string;
    // };
    id: p.id,
    slug: p.slug,
    permalink: remoteToLocalUrl(p.link),
  }));

  // Format subcategories
  formattedSubcategories = (subCategories || []).map((subcat: any) => ({
    name: subcat.name,
    slug: `${cleanSlug}/${subcat.slug}`,
    count: subcat.count || 0,
  }));

  allCategories = Object.values(getFlatCategories(blogCategoriesData))
    .filter((cat) => cat.count > 0)
    .map((cat) => ({
      href: `/category/${cat.slug}`,
      title: cat.name,
    }));
} else if (isPostPage) {
  title = post.title.rendered;

  date = post.date;

  // Fetch featured image
  if (post.featured_media) {
    try {
      const mediaResponse = await fetch(
        `${WORDPRESS_URL}/media/${post.featured_media}?_fields=source_url,alt_text`,
      );
      if (mediaResponse.ok) {
        const media = await mediaResponse.json();
        featuredImage = {
          src: swapImageUrlDomain(media.source_url),
          alt: media.alt_text || title,
        };
      }
    } catch (err) {
      // Ignore errors
    }
  }

  breadcrumbs.push({
    label: title,
    href: post.slug,
  });

  // Prepare description
  content = post.content.rendered;
  excerpt = post.excerpt.rendered;

  // Prepare categories
  categories = getCategoriesFromId(post?.categories || []);
}
---

{
  isCategoryPage ? (
    <BlogCategoryLayout
      title={catTitle || 'Categoria'}
      breadcrumbs={breadcrumbs}
      subcategories={formattedSubcategories}
      pagination={pagination}
      count={count}
      posts={formattedPosts}
      allCategories={allCategories}
    />
  ) : isPostPage ? (
    <BlogPostLayout
      content={content}
      categories={categories}
      title={title}
      date={date}
      breadcrumbs={breadcrumbs}
      featuredImage={featuredImage}
      excerpt={excerpt}
    />
  ) : null
}

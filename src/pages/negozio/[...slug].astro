---
import { getAllCategories } from "../../data/products";
import ProductLayout from "../../layouts/ProductLayout.astro";
import ShopCategoryLayout from "../../layouts/ShopCategoryLayout.astro";

export async function getStaticPaths() {
  const { categories, productsPages } = await getAllCategories();

  const categoryPages: {
    params: { slug: string };
    props: CategoryPageProps;
  }[] = categories.map(({ slug, ...category }) => ({
    params: {
      slug,
    },
    props: {
      ...category,
    },
  }));

  const usableProductPages = productsPages.map(({ slug, ...product }) => ({
    params: {
      slug,
    },
    props: {
      ...product,
    },
  }));

  // return [...categoryPages, ...usableProductPages];
  return [...categoryPages];
}

type Image = {
  alt: string;
  url: string;
};

type CategoryPageProps = {
  products: {
    fullSlug: string;
    image?: Image | null;
    name: string;
  }[];
  subCategories?: {
    url: string;
    name: string;
    count: number;
  }[];
  count: {
    total: number;
    start: number;
    end: number;
  };
  pagination?:
    | {
        current: PaginationPage;
        next: PaginationPage;
        first: PaginationPage;
        last: PaginationPage;
      }
    | {
        current: PaginationPage;
        previous: PaginationPage;
        first: PaginationPage;
        last: PaginationPage;
      }
    | {
        current: PaginationPage;
        previous: PaginationPage;
        next: PaginationPage;
        first: PaginationPage;
        last: PaginationPage;
      };
};

type ProductPageProps = {
  images: Image[] | null;
  description: string;
  fullDescription: {};
  formats: string | null;
  brand: string | null;
  categories: {
    name: string;
    url: string;
  }[];
};

type Props = {
  title: string;
  fullSlug: string;
  breadcrumbs: { label: string; url: string }[];
} & (CategoryPageProps | ProductPageProps);

type PaginationPage = {
  number: number;
  href: string;
};

const { title, fullSlug, breadcrumbs, ...passedProps } = Astro.props;

const checkIsCategoryPage = (
  props: CategoryPageProps | ProductPageProps,
): props is CategoryPageProps => {
  if ("products" in props) {
    return true;
  }

  return false;
};

// Determine if this is a category page or product page
const isCategoryPage = checkIsCategoryPage(passedProps);

const formattedBreadcrumbs = [
  { label: "Negozio", href: "/negozio/" },
  ...breadcrumbs.map((crumb) => ({
    ...crumb,
    href: `/negozio${crumb.url}/`,
  })),
];

// const renderedComponent = isCategoryPage ? (
//   <ShopCategoryLayout
//     title={title}
//     breadcrumbs={formattedBreadcrumbs}
//     fullSlug={fullSlug}
//     products={passedProps.products}
//     subcategories={passedProps.subCategories}
//     pagination={passedProps.pagination}
//     count={passedProps.count}
//   />
// ) : (
//   <ProductLayout
//     title={title}
//     breadcrumbs={formattedBreadcrumbs}
//     fullSlug={fullSlug}
//     images={passedProps.images || []}
//     description={passedProps.description}
//     fullDescription={passedProps.description}
//     formats={passedProps.formats}
//     categories={passedProps.categories}
//     brand={passedProps.brand}
//   />
// );

const Component = isCategoryPage ? ShopCategoryLayout : ProductLayout;
const props = isCategoryPage
  ? {
      title: title,
      breadcrumbs: formattedBreadcrumbs,
      fullSlug: fullSlug,
      products: passedProps.products,
      subcategories: passedProps.subCategories,
      pagination: passedProps.pagination,
      count: passedProps.count,
    }
  : {
      title: title,
      breadcrumbs: formattedBreadcrumbs,
      fullSlug: fullSlug,
      images: passedProps.images || [],
      description: passedProps.description,
      fullDescription: passedProps.description,
      formats: passedProps.formats,
      categories: passedProps.categories,
      brand: passedProps.brand,
    };
---

<Component {...props} />

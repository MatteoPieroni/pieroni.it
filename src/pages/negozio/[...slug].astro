---
import { getAllCategories } from "../../data/products";
import ProductLayout from "../../layouts/ProductLayout.astro";
import ShopCategoryLayout from "../../layouts/ShopCategoryLayout.astro";

export async function getStaticPaths() {
  const { categories, productsPages } = await getAllCategories();

  const categoryPages: {
    params: { slug: string };
    props: CategoryPageProps;
  }[] = categories.map(({ slug, ...category }) => ({
    params: {
      slug,
    },
    props: {
      ...category,
    },
  }));

  const usableProductPages: {
    params: { slug: string };
    props: ProductPageProps;
  }[] = productsPages.map(({ slug, ...product }) => ({
    params: {
      slug,
    },
    props: {
      ...product,
    },
  }));

  return [...categoryPages, ...usableProductPages];
}

type Image = {
  alt: string;
  url: string;
};

type CategoryPageProps = {
  products: {
    fullSlug: string;
    featuredImage: Image;
    name: string;
  }[];
  subCategories?: {
    url: string;
    name: string;
    count: number;
  }[];
  count: {
    total: number;
    start: number;
    end: number;
  };
  pagination?:
    | {
        current: PaginationPage;
        next: PaginationPage;
        first: PaginationPage;
        last: PaginationPage;
      }
    | {
        current: PaginationPage;
        previous: PaginationPage;
        first: PaginationPage;
        last: PaginationPage;
      }
    | {
        current: PaginationPage;
        previous: PaginationPage;
        next: PaginationPage;
        first: PaginationPage;
        last: PaginationPage;
      };
};

type ProductPageProps = {
  featuredImage: Image;
  images?: Image[] | null;
  description: string;
  fullDescription: string;
  formats: string | null;
  brand: string | null;
  categories: {
    name: string;
    url: string;
  }[];
};

type Props = {
  title: string;
  fullSlug: string;
  breadcrumbs: { label: string; url: string }[];
} & (CategoryPageProps | ProductPageProps);

type PaginationPage = {
  number: number;
  href: string;
};

const { title, fullSlug: passedFullSlug, breadcrumbs, ...props } = Astro.props;

const fullSlug = `/negozio/${passedFullSlug}/`;

const checkIsCategoryPage = (
  props: CategoryPageProps | ProductPageProps,
): props is CategoryPageProps => {
  if ("products" in props) {
    return true;
  }

  return false;
};

// Determine if this is a category page or product page
const isCategoryPage = checkIsCategoryPage(props);

const formattedBreadcrumbs = [
  { label: "Negozio", href: "/negozio/" },
  ...breadcrumbs.map(({ url, label }) => ({
    label,
    href: `/negozio${url}/`,
  })),
  ...(!isCategoryPage
    ? [
        {
          label: title,
          href: fullSlug,
        },
      ]
    : []),
];
---

{
  isCategoryPage ? (
    <ShopCategoryLayout
      title={title}
      breadcrumbs={formattedBreadcrumbs}
      fullSlug={fullSlug}
      products={props.products}
      subcategories={props.subCategories}
      pagination={props.pagination}
      count={props.count}
    />
  ) : (
    <ProductLayout
      title={title}
      breadcrumbs={formattedBreadcrumbs}
      fullSlug={fullSlug}
      featuredImage={props.featuredImage}
      images={props.images ?? undefined}
      description={props.description}
      fullDescription={props.fullDescription}
      formats={props.formats}
      categories={props.categories}
      brand={props.brand}
    />
  )
}

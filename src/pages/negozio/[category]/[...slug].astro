// Prepare images
const galleryImages = product.images || [];
const images = {
  featured: galleryImages[0]
    ? {
        src: galleryImages[0].src,
        alt: galleryImages[0].alt || title,
      }
    : undefined,
  gallery: galleryImages.slice(1).map((img: any) => ({
    src: img.src,
    alt: img.alt || title,
  })),
};

// Prepare description
const description = product.description || product.fullDescription;
const fullDescription = product.fullDescription;

// Prepare attributes
const attributes =
  product.attributes?.map((attr: any) => ({
    name: attr.name,
    slug: attr.slug,
    options: attr.options || [],
    visible: attr.visible,
  })) || [];

// // Prepare categories
const categories =
  product.categories?.map((cat: any) => ({
    name: cat.name,
    slug: cat.slug,
  })) || [];

import ProductLayout from '../../../layouts/ProductLayout.astro';
---

<ProductLayout
  title={title}
  breadcrumbs={breadcrumbs}
  images={images}
  description={description}
  fullDescription={fullDescription}
  attributes={attributes}
  categories={categories}
  ctaText="Sei interessato? Prendi un appuntamento!"
  ctaLink="/appuntamento-sala-mostra/"
/>

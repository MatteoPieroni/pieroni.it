---
import "../styles/global.css";
import Head from "../components/Head/Head.astro";
import MiniHeader from "../components/Menu/Mini.astro";
import MiniFooter from "../components/Footer/Mini.astro";
import type { PageProps } from "./types";
import { ensureTrailingSlash } from "../utils/slugs";

type Props = Omit<PageProps, "breadcrumbs"> & { accentColor?: string };

const { title, description, canonicalUrl, accentColor } = Astro.props;
---

<html lang="it">
  <Head
    title={title}
    description={description}
    canonicalUrl={typeof canonicalUrl === "string"
      ? ensureTrailingSlash(canonicalUrl)
      : canonicalUrl}
  />

  <body>
    <MiniHeader accentColor={accentColor} />

    <main id="content">
      <slot />
    </main>

    <MiniFooter accentColor={accentColor} />
  </body>
</html>

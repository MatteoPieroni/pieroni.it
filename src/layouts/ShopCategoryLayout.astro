---
import MenuLayout from './MenuLayout.astro';
import Pagination from '../components/Pagination.astro';

interface Product {
  id: number;
  name: string;
  slug: string;
  permalink: string;
  images: Array<{
    src: string;
    alt: string;
  }>;
}

interface Props {
  title: string;
  breadcrumbs: Array<{
    label: string;
    href: string;
  }>;
  products: Product[];
  subcategories?: Array<{
    name: string;
    slug: string;
    count: number;
  }>;
  count: {
    total: number;
    start: number;
    end: number;
  };
  pagination?: {
    current: PaginationPage;
    previous: PaginationPage;
    next: PaginationPage;
    first: PaginationPage;
    last: PaginationPage;
  };
}

type PaginationPage = {
  number: number;
  href: string;
};

const { title, breadcrumbs, products, subcategories, count, pagination } =
  Astro.props;
---

<MenuLayout breadcrumbs={breadcrumbs}>
  <div class="margin-container">
    <header class="row-small">
      <h1>{title}</h1>

      {
        products && products.length > 0 && (
          <div class="archive-toolbar">
            <p class="result-count">
              Visualizzazione di {count.start}–{count.end} di {count.total}{' '}
              risultati
            </p>

            {pagination && <Pagination pagination={pagination} />}
          </div>
        )
      }
    </header>

    {
      subcategories && subcategories.length > 0 && (
        <div class="row">
          <h2>Sottocategorie</h2>
          <ul class="subcategories-list">
            {subcategories.map((subcat) => (
              <li>
                <a href={`/negozio/${subcat.slug}/`} class="button">
                  {subcat.name} ({subcat.count})
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      products && products.length > 0 && (
        <div class="products-grid row">
          {products.map((product) => (
            <div class="product-card">
              <a href={product.permalink}>
                {product.images && product.images.length > 0 && (
                  <div class="product-image">
                    <img
                      src={product.images[0].src}
                      alt={product.images[0].alt || product.name}
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="product-info">
                  <h2>{product.name}</h2>
                </div>
              </a>
            </div>
          ))}
        </div>
      )
    }

    {
      (!products || products.length === 0) && (
        <p>Nessun prodotto trovato in questa categoria.</p>
      )
    }

    {
      products && products.length > 0 && (
        <div class="row archive-toolbar">
          <p class="result-count">
            Visualizzazione di {count.start}–{count.end} di {count.total}{' '}
            risultati
          </p>

          {pagination && <Pagination pagination={pagination} />}
        </div>
      )
    }
  </div>
</MenuLayout>

<style>
  h1 {
    text-align: center;
    font-size: 2.5rem;
    margin-block-end: 1rem;
  }

  .archive-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;

    @media (min-width: 960px) {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .result-count {
    margin: 0;
    font-size: 0.9rem;
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 100;
    margin-block-end: 1rem;
  }

  .subcategories-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .subcategories-list li {
    margin: 0;
  }

  .subcategories-list a {
    display: inline-block;
  }

  .products-grid {
    display: grid;
    gap: 2rem;

    @media (min-width: 960px) {
      gap: 3rem;
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .product-card {
    position: relative;
  }

  .product-card h2 {
    text-align: center;

    &:after {
      content: '';
      background: #ee8900;
      visibility: hidden;
      width: 20%;
      height: 0.35rem;
      position: absolute;
      bottom: -0.5rem;
      display: block;
      left: 50%;
      transform: translateX(-50%);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
  }

  .product-card:hover,
  .product-card:focus-within {
    & img {
      transform: translate(-5px, -5px);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    & h2:after {
      visibility: visible;
      -webkit-transform: translateX(-25%);
      -ms-transform: translateX(-25%);
      transform: translateX(-25%);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
  }

  .product-card a {
    display: block;
    text-decoration: none;
  }

  .product-image {
    width: 100%;
    margin-block-end: 1.5rem;
    aspect-ratio: 1;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

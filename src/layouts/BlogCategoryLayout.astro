---
import MenuLayout from './MenuLayout.astro';
import Pagination from '../components/Pagination.astro';
import Image from '../components/Image.astro';
import { Icon } from 'astro-icon/components';

interface BlogPost {
  id: number;
  title: string;
  permalink: string;
  excerpt: string;
  date: string;
  featuredImage?: {
    src: string;
    alt: string;
  };
}

interface Props {
  title: string;
  breadcrumbs: Array<{
    label: string;
    href: string;
  }>;
  posts: BlogPost[];
  subcategories?: Array<{
    name: string;
    slug: string;
    count: number;
  }>;
  count: {
    total: number;
    start: number;
    end: number;
  };
  pagination?: {
    current: PaginationPage;
    previous: PaginationPage;
    next: PaginationPage;
    first: PaginationPage;
    last: PaginationPage;
  };
  allCategories: {
    href: string;
    title: string;
  }[];
}

type PaginationPage = {
  number: number;
  href: string;
};

const {
  title,
  breadcrumbs,
  posts,
  subcategories,
  count,
  pagination,
  allCategories,
} = Astro.props;
---

<MenuLayout
  breadcrumbs={breadcrumbs}
  title={title}
  description={`Vedi tutti i post nella categoria ${title} del blog di Pieroni srl`}
>
  <div class="margin-container">
    <header class="row-small">
      <h1>Categoria: {title}</h1>

      {
        posts && posts.length > 0 && (
          <div class="archive-toolbar">
            <p class="result-count">
              Visualizzazione di {count.start}–{count.end} di {count.total}{' '}
              risultati
            </p>
          </div>
        )
      }
    </header>

    <div class="category-wrapper">
      <div>
        {
          subcategories && subcategories.length > 0 && (
            <div class="row">
              <h2>Sottocategorie</h2>
              <ul class="subcategories-list">
                {subcategories.map((subcat) => (
                  <li>
                    <a href={`/category/${subcat.slug}/`} class="button">
                      {subcat.name} ({subcat.count})
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          posts && posts.length > 0 && (
            <div class="row">
              <h2>Articoli</h2>
              {posts.map((post) => (
                <article class="blog-post">
                  <time class="blog-post-date" datetime={post.date}>
                    {new Date(post.date).toLocaleDateString('it-IT', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>

                  {post.featuredImage && (
                    <div class="blog-post-image">
                      <a href={`/category${post.permalink}`}>
                        <Image
                          src={post.featuredImage.src}
                          alt={post.featuredImage.alt || post.title}
                          loading="lazy"
                          remote
                        />
                      </a>
                    </div>
                  )}

                  <a
                    href={`/category${post.permalink}`}
                    class="post-title-link"
                  >
                    <h2>{post.title}</h2>
                  </a>
                  {post.excerpt && (
                    <div class="blog-post-excerpt">
                      <div set:html={post.excerpt} />

                      <a href={`/category${post.permalink}`}>
                        Continua a leggere
                        <span class="screen-reader-text"> {post.title}</span>
                      </a>
                    </div>
                  )}
                </article>
              ))}
            </div>
          )
        }

        {
          (!posts || posts.length === 0) && (
            <p>Nessun articolo trovato in questa categoria.</p>
          )
        }
      </div>

      <div class="row">
        <div class="categories-list-container">
          <h2>Tutte le categorie</h2>
          <ul class="categories-list">
            {
              allCategories.map((cat) => (
                <li>
                  <Icon name="tabler:folder" />
                  <a href={cat.href}>{cat.title}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    {
      posts && posts.length > 0 && pagination && (
        <div class="row archive-toolbar">
          <Pagination pagination={pagination} basePath="/category" />
        </div>
      )
    }
  </div>
</MenuLayout>

<style>
  h1 {
    text-align: center;
    font-size: 2.5rem;
    margin-block-end: 1rem;
  }

  .archive-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;

    @media (min-width: 960px) {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .result-count {
    margin: 0;
    font-size: 0.9rem;
  }

  .category-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;

    @media (min-width: 960px) {
      grid-template-columns: 1fr minmax(250px, min-content);
      gap: 3rem;
    }
  }

  .subcategories-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 0.75rem;
  }

  .subcategories-list li {
    margin: 0;
  }

  .subcategories-list li a {
    display: block;
  }

  .blog-post {
    margin-block-end: 2rem;
    padding: 1rem;
    background: var(--bg-darker);
  }

  .post-title-link {
    text-decoration: none;
  }

  .blog-post h2 {
    margin-block-end: 1rem;
  }

  .blog-post-image {
    width: 100%;
    margin-block-end: 1.5rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-darker);
  }

  .blog-post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .blog-post-excerpt {
    margin-block-end: 1rem;
    font-size: 0.9rem;
  }

  .blog-post-excerpt p {
    margin: 0;
  }

  .blog-post-date {
    display: block;
    margin-block-end: 0.75rem;
    font-size: 0.875rem;
  }

  .categories-list-container {
    padding: 1rem;
    background: var(--bg-darker);
  }

  .categories-list-container h2 {
    font-size: 1.25rem;
    padding-block-end: 0.5rem;
    border-block-end: 1px solid var(--color-blue);
  }

  .categories-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .categories-list li {
    display: flex;
    align-items: center;
    margin-block-end: 0.5rem;
    gap: 0.5rem;
  }
</style>

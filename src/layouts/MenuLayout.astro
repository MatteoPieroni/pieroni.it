---
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import '../styles/global.css';
import Head from '../components/Head/Head.astro';
import type { PageProps } from './types';

type Props = ({ isHome: true } & Omit<PageProps, 'breadcrumbs'>) | PageProps;

const { title, description, canonicalUrl, ...props } = Astro.props;
const breadcrumbs = 'breadcrumbs' in props ? props.breadcrumbs : undefined;
const isHome = 'isHome' in props ? props.isHome : undefined;
---

<html lang="it">
  <Head
    title={title}
    breadcrumbs={breadcrumbs}
    description={description}
    isHome={isHome}
    canonicalUrl={canonicalUrl}
  />

  <body>
    <Menu />

    {
      breadcrumbs && breadcrumbs.length > 0 && (
        <div class="margin-container breadcrumbs-container">
          <Breadcrumbs items={breadcrumbs} />
        </div>
      )
    }

    <main id="content">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  .breadcrumbs-container {
    margin-block-end: 0.75rem;
  }
</style>

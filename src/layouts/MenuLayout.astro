---
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import '@fontsource/source-sans-pro/latin-300.css';
import '@fontsource/source-sans-pro/latin-400.css';
import '@fontsource/source-sans-pro/latin-600.css';
import sourceSansWoff2 from '@fontsource/source-sans-pro/files/source-sans-pro-latin-300-normal.woff';
import '../styles/global.css';
import Head from '../components/Head/Head.astro';

interface Props {
  title: string;
  description: string;
  breadcrumbs?: Array<{
    label: string;
    href: string;
  }>;
}

const { breadcrumbs, title, description } = Astro.props;
---

<html lang="it">
  <Head
    title={title}
    breadcrumbs={breadcrumbs}
    description={description}
    fontToPreload={sourceSansWoff2}
  />

  <body>
    <Menu />

    {
      breadcrumbs && breadcrumbs.length > 0 && (
        <div class="margin-container">
          <Breadcrumbs items={breadcrumbs} />
        </div>
      )
    }

    <main id="content">
      <slot />
    </main>

    <Footer />
  </body>
</html>

---
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import '@fontsource/source-sans-pro/latin-300.css';
import '@fontsource/source-sans-pro/latin-400.css';
import '@fontsource/source-sans-pro/latin-600.css';
import sourceSansWoff2 from '@fontsource/source-sans-pro/files/source-sans-pro-latin-300-normal.woff';
import '../styles/global.css';
import Head from '../components/Head/Head.astro';
import type { PageProps } from './types';

type Props = ({ isHome: true } & Omit<PageProps, 'breadcrumbs'>) | PageProps;

const { title, description, ...props } = Astro.props;
const breadcrumbs = 'breadcrumbs' in props ? props.breadcrumbs : undefined;
const isHome = 'isHome' in props ? props.isHome : undefined;
---

<html lang="it">
  <Head
    title={title}
    breadcrumbs={breadcrumbs}
    description={description}
    fontToPreload={sourceSansWoff2}
    isHome={isHome}
  />

  <body>
    <Menu />

    {
      breadcrumbs && breadcrumbs.length > 0 && (
        <div class="margin-container">
          <Breadcrumbs items={breadcrumbs} />
        </div>
      )
    }

    <main id="content">
      <slot />
    </main>

    <Footer />
  </body>
</html>

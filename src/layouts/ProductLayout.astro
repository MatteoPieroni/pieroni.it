---
import MenuLayout from "./MenuLayout.astro";
import Image from "../components/Image.astro";
import { getMetaDescriptionFromHtmlDescription } from "../utils/seo";
import type { PageProps } from "./types";
import Link from "../components/Link.astro";

interface ProductImage {
  url: string;
  alt?: string;
}

interface ProductCategory {
  name: string;
  url?: string;
}

type Props = PageProps & {
  featuredImage: ProductImage;
  images?: ProductImage[];
  description?: string;
  fullSlug: string;
  fullDescription?: string;
  brand?: string | null;
  formats?: string | null;
  categories?: ProductCategory[];
  ctaText?: string;
  ctaLink?: string;
};

const {
  title,
  breadcrumbs,
  featuredImage,
  images,
  description,
  fullSlug,
  fullDescription,
  brand,
  formats,
  categories,
  ctaText = "Sei interessato? Prendi un appuntamento!",
  ctaLink = "/appuntamento-sala-mostra/",
} = Astro.props;

const parsedDescription = getMetaDescriptionFromHtmlDescription(description);
---

<MenuLayout
  breadcrumbs={breadcrumbs}
  title={title}
  description={parsedDescription}
  canonicalUrl={fullSlug}
>
  <div class="margin-container product-page">
    <div class="product-gallery">
      <div class="featured-image">
        <Link href={featuredImage.url} data-fslightbox data-type="image">
          <Image
            src={featuredImage.url}
            alt={featuredImage.alt || title}
            loading="lazy"
            remote
          />
        </Link>
      </div>
      {
        images && images.length > 0 && (
          <div class="gallery-images">
            {images.map((image) => (
              <Link href={image.url} data-fslightbox data-type="image">
                <Image
                  src={image.url}
                  alt={image.alt || title}
                  loading="lazy"
                  remote
                />
              </Link>
            ))}
          </div>
        )
      }
    </div>

    <div class="product-info row">
      <h1>{title}</h1>

      {
        description && (
          <div class="product-description">
            <p set:html={description} />
          </div>
        )
      }
      <div class="product-cta row">
        <p>
          <strong>{ctaText}</strong>
        </p>
        <Link href={ctaLink} class="button">Prendi un appuntamento</Link>
      </div>

      {
        categories && categories.length > 0 && (
          <p>
            <strong>Categorie:</strong>{" "}
            {categories.map((cat, index) => (
              <>
                {index > 0 && ", "}
                {cat.url ? (
                  <Link href={`/negozio/${cat.url}/`}>{cat.name}</Link>
                ) : (
                  <span>{cat.name}</span>
                )}
              </>
            ))}
          </p>
        )
      }
    </div>

    <div class="product-full-description">
      {
        fullDescription && (
          <div class="row">
            <h2>Descrizione</h2>
            <div set:html={fullDescription} />
          </div>
        )
      }

      {
        (brand || formats) && (
          <div class="product-attributes row">
            <h2>Informazioni aggiuntive</h2>
            <table>
              <tbody>
                {brand && (
                  <tr>
                    <td>Marca</td>
                    <td>{brand}</td>
                  </tr>
                )}
                {formats && (
                  <tr>
                    <td>Formati</td>
                    <td>{formats}</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        )
      }
    </div>
  </div>
</MenuLayout>

<style>
  .product-page {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "image"
      "info"
      "description";
    gap: 2rem;

    @media (min-width: 960px) {
      grid-template-areas:
        "image info"
        "description description";
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .product-gallery {
    grid-area: image;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .featured-image img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .gallery-images {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  .gallery-images img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    transition: opacity 0.2s;
    aspect-ratio: 1;
  }

  .gallery-images img:hover,
  .gallery-images img:focus {
    opacity: 0.8;
  }

  .product-info {
    grid-area: info;
  }

  .product-info h1 {
    font-size: 2.75em;
  }

  .product-full-description {
    grid-area: description;
  }

  .product-attributes table {
    width: 100%;
    border-collapse: collapse;
    margin-block-start: 1rem;
  }

  .product-attributes td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--bg-darker);
    text-align: left;
  }

  .product-attributes td:first-child {
    font-weight: 600;
    width: 40%;
  }

  .product-cta {
    padding: 1.5rem;
    background: var(--bg-darker);
    border-radius: var(--radius);
  }

  .product-cta p {
    margin: 0;
    margin-block-end: 1rem;
  }

  .product-cta .button {
    display: inline-block;
  }
</style>

<script>
  import "fslightbox";
</script>

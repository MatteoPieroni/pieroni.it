---
import MenuLayout from './MenuLayout.astro';
import Image from '../components/Image.astro';
import { getMetaDescriptionFromHtmlDescription } from '../utils/seo';
import type { PageProps, PropsWithSEO } from './types';

interface ProductImage {
  src: string;
  alt?: string;
}

interface ProductAttribute {
  name: string;
  slug?: string;
  options: string[];
  visible?: boolean;
}

interface ProductCategory {
  name: string;
  slug?: string;
}

type Props = PageProps & {
  images?: {
    featured?: ProductImage;
    gallery?: ProductImage[];
  };
  description?: string;
  fullDescription?: string;
  attributes?: ProductAttribute[];
  categories?: ProductCategory[];
  ctaText?: string;
  ctaLink?: string;
};

const {
  title,
  breadcrumbs,
  images,
  description,
  fullDescription,
  attributes,
  categories,
  ctaText = 'Sei interessato? Prendi un appuntamento!',
  ctaLink = '/appuntamento-sala-mostra/',
} = Astro.props;

const parsedDescription = getMetaDescriptionFromHtmlDescription(description);
---

<MenuLayout
  breadcrumbs={breadcrumbs}
  title={title}
  description={parsedDescription}
>
  <div class="margin-container product-page">
    {
      images && (
        <div class="product-gallery">
          {images.featured && (
            <div class="featured-image">
              <Image
                src={images.featured.src}
                alt={images.featured.alt || title}
                loading="lazy"
                remote
              />
            </div>
          )}
          {images.gallery && images.gallery.length > 0 && (
            <div class="gallery-images">
              {images.gallery.map((image) => (
                <Image
                  src={image.src}
                  alt={image.alt || title}
                  loading="lazy"
                  aspectRatio={1}
                  remote
                />
              ))}
            </div>
          )}
        </div>
      )
    }

    <div class="product-info row">
      <h1>{title}</h1>

      {
        description && (
          <div class="product-description" set:html={description} />
        )
      }
      <div class="product-cta">
        <p>
          <strong>{ctaText}</strong>
        </p>
        <a href={ctaLink} class="button"> Prendi un appuntamento </a>
      </div>

      {
        categories && categories.length > 0 && (
          <div class="product-categories">
            <p>
              <strong>Categorie:</strong>{' '}
              {categories.map((cat, index) => (
                <>
                  {index > 0 && ', '}
                  <a href={cat.slug ? `/negozio/${cat.slug}/` : '#'}>
                    {cat.name}
                  </a>
                </>
              ))}
            </p>
          </div>
        )
      }
    </div>

    <div class="product-full-description">
      {
        fullDescription && (
          <div class="row">
            <h2>Descrizione</h2>
            <div set:html={fullDescription} />
          </div>
        )
      }

      {
        attributes && attributes.length > 0 && (
          <div class="product-attributes row">
            <h2>Informazioni aggiuntive</h2>
            <table>
              <tbody>
                {attributes
                  .filter((attr) => attr.visible !== false)
                  .map((attr) => (
                    <tr>
                      <td>{attr.name}</td>
                      <td>
                        {attr.options.map((option: string, index: number) => {
                          return (
                            <>
                              {index > 0 && ', '}
                              {option}
                            </>
                          );
                        })}
                      </td>
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>
  </div>
</MenuLayout>

<style>
  .product-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;

    @media (min-width: 960px) {
      grid-template-areas:
        'image info'
        'description description';
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .product-gallery {
    grid-area: image;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .featured-image img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .gallery-images {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 0.5rem;
  }

  .gallery-images img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .gallery-images img:hover {
    opacity: 0.8;
  }

  .product-info {
    grid-area: info;
  }

  .product-full-description {
    grid-area: description;
  }

  .product-attributes {
    grid-area: description;
  }

  .product-attributes table {
    width: 100%;
    border-collapse: collapse;
    margin-block-start: 1rem;
  }

  .product-attributes td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--bg-darker);
    text-align: left;
  }

  .product-attributes td:first-child {
    font-weight: 600;
    width: 40%;
  }

  .product-categories {
    margin-block-start: 1rem;
  }

  .product-cta {
    padding: 1.5rem;
    background: var(--bg-darker);
    border-radius: var(--radius);
  }

  .product-cta p {
    margin: 0;
    margin-block-end: 1rem;
  }

  .product-cta .button {
    display: inline-block;
  }
</style>

---
import MenuLayout from './MenuLayout.astro';
import Image from '../components/Image.astro';
import { getMetaDescriptionFromHtmlDescription } from '../utils/seo';
import type { PageProps } from './types';

interface ProductImage {
  src: string;
  alt?: string;
}

interface ProductAttribute {
  name: string;
  slug?: string;
  options: string[];
  visible?: boolean;
}

interface ProductCategory {
  name: string;
  slug?: string;
}

type Props = PageProps & {
  images?: ProductImage[];
  description?: string;
  fullDescription?: string;
  attributes?: ProductAttribute[];
  categories?: ProductCategory[];
  ctaText?: string;
  ctaLink?: string;
};

const {
  title,
  breadcrumbs,
  images,
  description,
  fullDescription,
  attributes,
  categories,
  ctaText = 'Sei interessato? Prendi un appuntamento!',
  ctaLink = '/appuntamento-sala-mostra/',
} = Astro.props;

const parsedDescription = getMetaDescriptionFromHtmlDescription(description);
---

<MenuLayout
  breadcrumbs={breadcrumbs}
  title={title}
  description={parsedDescription}
>
  <div class="margin-container product-page">
    {
      images && images.length > 0 && (
        <div class="product-gallery">
          <div class="featured-image">
            <a href={images[0].src} data-fslightbox data-type="image">
              <Image
                src={images[0].src}
                alt={images[0].alt || title}
                loading="lazy"
                remote
              />
            </a>
          </div>
          <div class="gallery-images">
            {images.slice(1).map((image) => (
              <a href={image.src} data-fslightbox data-type="image">
                <Image
                  src={image.src}
                  alt={image.alt || title}
                  loading="lazy"
                  remote
                />
              </a>
            ))}
          </div>
        </div>
      )
    }

    <div class="product-info row">
      <h1>{title}</h1>

      {
        description && (
          <div class="product-description" set:html={description} />
        )
      }
      <div class="product-cta row">
        <p>
          <strong>{ctaText}</strong>
        </p>
        <a href={ctaLink} class="button"> Prendi un appuntamento </a>
      </div>

      {
        categories && categories.length > 0 && (
          <p>
            <strong>Categorie:</strong>{' '}
            {categories.map((cat, index) => (
              <>
                {index > 0 && ', '}
                {cat.slug ? (
                  <a href={`/negozio/${cat.slug}/`}>{cat.name}</a>
                ) : (
                  <p>{cat.name}</p>
                )}
              </>
            ))}
          </p>
        )
      }
    </div>

    <div class="product-full-description">
      {
        fullDescription && (
          <div class="row">
            <h2>Descrizione</h2>
            <div set:html={fullDescription} />
          </div>
        )
      }

      {
        attributes && attributes.length > 0 && (
          <div class="product-attributes row">
            <h2>Informazioni aggiuntive</h2>
            <table>
              <tbody>
                {attributes
                  .filter((attr) => attr.visible !== false)
                  .map((attr) => (
                    <tr>
                      <td>{attr.name}</td>
                      <td>
                        {attr.options.map((option: string, index: number) => {
                          return (
                            <>
                              {index > 0 && ', '}
                              {option}
                            </>
                          );
                        })}
                      </td>
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>
  </div>
</MenuLayout>

<style>
  .product-page {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'image'
      'info'
      'description';
    gap: 2rem;

    @media (min-width: 960px) {
      grid-template-areas:
        'image info'
        'description description';
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .product-gallery {
    grid-area: image;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .featured-image img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .gallery-images {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  .gallery-images img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    transition: opacity 0.2s;
    aspect-ratio: 1;
  }

  .gallery-images img:hover {
    opacity: 0.8;
  }

  .product-info {
    grid-area: info;
  }

  .product-info h1 {
    font-size: 2.75em;
  }

  .product-full-description {
    grid-area: description;
  }

  .product-attributes table {
    width: 100%;
    border-collapse: collapse;
    margin-block-start: 1rem;
  }

  .product-attributes td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--bg-darker);
    text-align: left;
  }

  .product-attributes td:first-child {
    font-weight: 600;
    width: 40%;
  }

  .product-cta {
    padding: 1.5rem;
    background: var(--bg-darker);
    border-radius: var(--radius);
  }

  .product-cta p {
    margin: 0;
    margin-block-end: 1rem;
  }

  .product-cta .button {
    display: inline-block;
  }
</style>

<script>
  import 'fslightbox';
</script>

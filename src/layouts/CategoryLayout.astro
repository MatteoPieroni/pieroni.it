---
import MenuLayout from './MenuLayout.astro';
import Hero from '../components/Hero.astro';
import Locations from '../components/Locations.astro';
import Professionals from '../components/Professionals.astro';
import Image from '../components/Image.astro';
import type { PageProps } from './types';

type Props = PageProps & {
  title: string;
  heroImage: ImageMetadata;
  gridItems?: Array<
    {
      title: string;
      description: string;
      linkHref?: string;
      linkText?: string;
    } & (
      | ({
          imageAlt: string;
        } & ({ image: ImageMetadata } | { image: string; remote: true }))
      | { imageAlt?: never; image?: never }
    )
  >;
  seoTitle: string;
  withoutLocations?: boolean;
};

const {
  title,
  heroImage,
  gridItems,
  breadcrumbs,
  withoutLocations,
  seoTitle,
  description,
} = Astro.props;
---

<MenuLayout
  breadcrumbs={breadcrumbs}
  title={seoTitle}
  description={description}
>
  <Hero title={title} heroImage={heroImage} />

  <div class="margin-container row">
    <div class="small-12 intro-text">
      <slot name="description" />
    </div>
  </div>

  {
    gridItems?.length && (
      <section class="subcategories-grid margin-container row">
        {gridItems.map((item) => (
          <div class="card">
            {item.image &&
              (item.linkHref ? (
                <a href={item.linkHref} title={item.linkText || item.title}>
                  <Image
                    alt={item.imageAlt}
                    {...('remote' in item
                      ? { remote: true, src: item.image }
                      : { src: item.image })}
                  />
                </a>
              ) : (
                <Image
                  alt={item.imageAlt}
                  {...('remote' in item
                    ? { remote: true, src: item.image }
                    : { src: item.image })}
                />
              ))}
            <div class="card-body">
              {item.linkHref ? (
                <a href={item.linkHref} title={item.linkText || item.title}>
                  <h2>{item.title}</h2>
                </a>
              ) : (
                <h2>{item.title}</h2>
              )}
              <Fragment set:html={item.description} />
              {item.linkHref && item.linkText && (
                <a href={item.linkHref} title={item.linkText} class="button">
                  {item.linkText}
                </a>
              )}
            </div>
          </div>
        ))}
      </section>
    )
  }

  {
    !withoutLocations && (
      <div class="row">
        <Locations />
      </div>
    )
  }

  <div class="margin-container row">
    <Professionals />
  </div>
</MenuLayout>

<style>
  .intro-text p {
    margin-block-end: 1rem;
    line-height: 1.6;
  }

  .subcategories-grid {
    display: grid;
    gap: 2.5rem;

    @media (min-width: 960px) {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }
  }

  .card img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius) var(--radius) 0 0;
    aspect-ratio: 1;
  }

  .card-body {
    padding: 1.5rem;
  }

  .card-body h2 {
    margin: 0 0 1rem;
    font-size: 1.75em;
    font-weight: 100;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .card-body p {
    margin-block-end: 1rem;
    line-height: 1.6;
  }
</style>

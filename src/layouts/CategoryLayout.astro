---
import MenuLayout from './MenuLayout.astro';
import Hero from '../components/Hero.astro';
import Locations from '../components/Locations.astro';
import Professionals from '../components/Professionals.astro';
import Image from '../components/Image.astro';

interface Props {
  title: string;
  heroImage: ImageMetadata;
  gridItems?: Array<{
    image: ImageMetadata;
    imageAlt: string;
    title: string;
    description: string;
    linkHref?: string;
    linkText?: string;
  }>;
  seoTitle: string;
  description: string;
  breadcrumbs: Array<{
    label: string;
    href: string;
  }>;
  withoutLocations?: boolean;
}

const {
  title,
  heroImage,
  gridItems,
  breadcrumbs,
  withoutLocations,
  seoTitle,
  description,
} = Astro.props;
---

<MenuLayout
  breadcrumbs={breadcrumbs}
  title={seoTitle}
  description={description}
>
  <Hero title={title} heroImage={heroImage} />

  <div class="margin-container row">
    <div class="small-12 intro-text">
      <slot name="description" />
    </div>
  </div>

  {
    gridItems?.length && (
      <section class="subcategories-grid margin-container row">
        {gridItems.map((item) => (
          <div class="card">
            {item.linkHref ? (
              <a href={item.linkHref} title={item.linkText || item.title}>
                <Image src={item.image} alt={item.imageAlt} />
              </a>
            ) : (
              <Image src={item.image} alt={item.imageAlt} />
            )}
            <div class="card-body">
              {item.linkHref ? (
                <a href={item.linkHref} title={item.linkText || item.title}>
                  <h2>{item.title}</h2>
                </a>
              ) : (
                <h2>{item.title}</h2>
              )}
              <Fragment set:html={item.description} />
              {item.linkHref && item.linkText && (
                <a href={item.linkHref} title={item.linkText} class="button">
                  {item.linkText}
                </a>
              )}
            </div>
          </div>
        ))}
      </section>
    )
  }

  {
    !withoutLocations && (
      <div class="row">
        <Locations />
      </div>
    )
  }

  <div class="margin-container row">
    <Professionals />
  </div>
</MenuLayout>

<style>
  .intro-text p {
    margin-block-end: 1rem;
    line-height: 1.6;
  }

  .subcategories-grid {
    display: grid;
    gap: 2.5rem;

    @media (min-width: 960px) {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }
  }

  .card img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .card-body {
    padding: 1.5rem;
  }

  .card-body h2 {
    margin: 0 0 1rem;
    font-size: 1.75em;
    font-weight: 100;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .card-body p {
    margin-block-end: 1rem;
    line-height: 1.6;
  }
</style>

---
import MenuLayout from './MenuLayout.astro';
import Hero from '../components/Hero.astro';
import Locations from '../components/Locations.astro';
import Professionals from '../components/Professionals.astro';

interface Props {
  title: string;
  heroImage: string;
  description: string;
  gridItems: Array<{
    image: string;
    imageAlt: string;
    title: string;
    description: string;
    linkHref?: string;
    linkText?: string;
  }>;
  breadcrumbs: Array<{
    label: string;
    href: string;
  }>;
  withoutLocations?: boolean;
}

const {
  title,
  heroImage,
  description,
  gridItems,
  breadcrumbs,
  withoutLocations,
} = Astro.props;
---

<MenuLayout breadcrumbs={breadcrumbs}>
  <Hero title={title} heroImage={heroImage} />

  <div class="margin-container row">
    <div class="small-12 intro-text">
      <Fragment set:html={description} />
    </div>
  </div>

  <section class="subcategories-grid margin-container row">
    {
      gridItems.map((item) => (
        <div class="card">
          {item.linkHref ? (
            <a href={item.linkHref} title={item.linkText || item.title}>
              <img src={item.image} alt={item.imageAlt} />
            </a>
          ) : (
            <img src={item.image} alt={item.imageAlt} />
          )}
          <div class="card-body">
            {item.linkHref ? (
              <a href={item.linkHref} title={item.linkText || item.title}>
                <h2>{item.title}</h2>
              </a>
            ) : (
              <h2>{item.title}</h2>
            )}
            <Fragment set:html={item.description} />
            {item.linkHref && item.linkText && (
              <a href={item.linkHref} title={item.linkText} class="button">
                {item.linkText}
              </a>
            )}
          </div>
        </div>
      ))
    }
  </section>

  {
    !withoutLocations && (
      <div class="row">
        <Locations />
      </div>
    )
  }

  <div class="margin-container row">
    <Professionals />
  </div>
</MenuLayout>

<style>
  .intro-text p {
    margin-block-end: 1rem;
    line-height: 1.6;
  }

  .subcategories-grid {
    @media (min-width: 960px) {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }
  }

  .card img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .card-body {
    padding: 1.5rem;
  }

  .card-body h2 {
    margin: 0 0 1rem;
    font-size: 1.75em;
    font-weight: 100;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .card-body p {
    margin-block-end: 1rem;
    line-height: 1.6;
  }
</style>
